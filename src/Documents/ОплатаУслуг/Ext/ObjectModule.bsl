// Формирует расход задолженности по каждой оплачиваемой записи с проверкой данных.
// Параметры: Отказ - Булево - Истина отменяет проведение;
//            РежимПроведения - РежимПроведенияДокумента - режим проведения.
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Проверка шапки: покупатель обязателен и должны быть строки оплаты.
	Если Не ЗначениеЗаполнено(Покупатель) Тогда
		Сообщить("Заполните покупателя.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если ОплачиваемыеЗаписи.Количество() = 0 Тогда
		Сообщить("Добавьте хотя бы одну оплачиваемую запись.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Движения.ОказанныеУслуги.Записывать = Истина;

	Для Каждого Строка Из ОплачиваемыеЗаписи Цикл
		Если Не ЗначениеЗаполнено(Строка.Запись) Тогда
			Сообщить("Строка " + Строка.НомерСтроки + ": не выбрана запись на приём.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Если Строка.Сумма <= 0 Тогда
			Сообщить("Строка " + Строка.НомерСтроки + ": сумма оплаты должна быть больше нуля.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Если Не Строка.Запись.Проведен Тогда
			Сообщить("Строка " + Строка.НомерСтроки + ": запись на приём не проведена.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Если Строка.Запись.Статус <> Перечисления.СтатусыЗаписи.УслугаОказана Тогда
			Сообщить("Строка " + Строка.НомерСтроки + ": по записи услуга ещё не оказана.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Если Строка.Запись.Покупатель <> Покупатель Тогда
			Сообщить("Строка " + Строка.НомерСтроки + ": запись относится к другому покупателю.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		Если Строка.Сумма > ПолучитьСуммуЗаписи(Строка.Запись) Тогда
			Сообщить("Строка " + Строка.НомерСтроки + ": сумма оплаты больше суммы записи.");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Движение = Движения.ОказанныеУслуги.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Покупатель = Покупатель;
		Движение.Запись = Строка.Запись;
		Движение.СуммаЗадолженности = Строка.Сумма;
	КонецЦикла;

КонецПроцедуры

// Возвращает общую сумму услуг записи на приём.
// Параметры: Запись - ДокументСсылка.ЗаписьНаПриём - запись, по которой считается сумма.
// Возврат: Число - сумма всех строк перечня услуг записи.
Функция ПолучитьСуммуЗаписи(Запись)

	// Запрос суммирует колонку «Сумма» табличной части выбранной записи.
	// Параметры запроса: Запись.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Услуги.Сумма), 0) КАК Сумма
	|ИЗ
	|	Документ.ЗаписьНаПриём.ПереченьУслуг КАК Услуги
	|ГДЕ
	|	Услуги.Ссылка = &Запись";
	Запрос.УстановитьПараметр("Запись", Запись);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции
// Проверяет заполнение, пересчитывает суммы и ищет пересечение по времени у исполнителя.
// Параметры: Отказ - Булево - Истина отменяет запись.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Не ЗначениеЗаполнено(Исполнитель) Или Не ЗначениеЗаполнено(Покупатель) Тогда
		Сообщить("Заполните исполнителя и покупателя.");
		Отказ = Истина;
	КонецЕсли;

	Если ДатаОкончания <= ДатаНачала Тогда
		Сообщить("Время окончания должно быть позже времени начала.");
		Отказ = Истина;
	КонецЕсли;

	Если ПереченьУслуг.Количество() = 0 Тогда
		Сообщить("Добавьте хотя бы одну услугу.");
		Отказ = Истина;
	КонецЕсли;
	
	// Проверка: организация заполнена; в каждой строке выбрана услуга и количество больше нуля.
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Заполните организацию.");
		Отказ = Истина;
	КонецЕсли;
	Для Каждого СтрокаПроверки Из ПереченьУслуг Цикл
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Услуга) Тогда
			Сообщить("В строке " + СтрокаПроверки.НомерСтроки + " выберите услугу.");
			Отказ = Истина;
		КонецЕсли;
		Если СтрокаПроверки.Количество <= 0 Тогда
			Сообщить("В строке " + СтрокаПроверки.НомерСтроки + " укажите количество больше нуля.");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Нумерация строк, цена по умолчанию из справочника, сумма строки.
	Для Каждого Строка Из ПереченьУслуг Цикл
		Строка.НомерПоПорядку = Строка.НомерСтроки;
		Если Строка.Цена = 0 Тогда
			Строка.Цена = Строка.Услуга.Цена;
		КонецЕсли;
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;

	// Запрос: есть ли другая запись этого исполнителя в то же время.
	// Параметры: Исполнитель, ДатаНачала, ДатаОкончания, ТекущаяСсылка.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Запись.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаписьНаПриём КАК Запись
	|ГДЕ
	|	Запись.Исполнитель = &Исполнитель
	|	И Запись.Ссылка <> &ТекущаяСсылка
	|	И Запись.ПометкаУдаления = ЛОЖЬ
	|	И Запись.ДатаНачала < &ДатаОкончания
	|	И Запись.ДатаОкончания > &ДатаНачала";
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("ТекущаяСсылка", Ссылка);

	Если Не Запрос.Выполнить().Пустой() Тогда
		Сообщить("Исполнитель уже занят в это время.");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

// Формирует приход задолженности, только если статус «Услуга оказана».
// Параметры: Отказ, РежимПроведения - стандартные параметры проведения.
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ОказанныеУслуги.Записывать = Истина;

	Если Статус <> Перечисления.СтатусыЗаписи.УслугаОказана Тогда
		Возврат;
	КонецЕсли;

	Движение = Движения.ОказанныеУслуги.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = ДатаОкончания;
	Движение.Покупатель = Покупатель;
	Движение.Запись = Ссылка;
	Движение.СуммаЗадолженности = ПереченьУслуг.Итог("Сумма");

КонецПроцедуры
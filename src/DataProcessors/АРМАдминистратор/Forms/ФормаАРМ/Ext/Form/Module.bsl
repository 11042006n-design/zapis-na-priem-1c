// Заполняет планировщик сотрудниками и записями на приём за 7 дней.
// Параметры: нет. Использует реквизит формы НачалоПериода.
&НаСервере
Процедура ЗаполнитьПланировщикНаСервере()

	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериода = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	КонецПериода = КонецДня(НачалоПериода + 6 * 86400);

	Планировщик.Элементы.Очистить();
	Планировщик.Измерения.Очистить();
	Планировщик.ТекущиеПериодыОтображения.Очистить();
	Планировщик.ТекущиеПериодыОтображения.Добавить(НачалоПериода, КонецПериода);

	// Измерение «Сотрудник»: один столбец на каждого сотрудника.
	Измерение = Планировщик.Измерения.Добавить("Сотрудник");
	ЗапросСотрудников = Новый Запрос;
	ЗапросСотрудников.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СотрудникиОрганизации КАК Сотрудники
	|ГДЕ
	|	Сотрудники.ПометкаУдаления = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование";
	ВыборкаСотрудников = ЗапросСотрудников.Выполнить().Выбрать();
	Пока ВыборкаСотрудников.Следующий() Цикл
		Измерение.Элементы.Добавить(ВыборкаСотрудников.Ссылка);
	КонецЦикла;

	// Записи на приём, попадающие в видимый период.
	// Параметры запроса: Начало, Конец - границы периода.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запись.Ссылка КАК Ссылка,
	|	Запись.Исполнитель КАК Исполнитель,
	|	Запись.Покупатель КАК Покупатель,
	|	Запись.ДатаНачала КАК ДатаНачала,
	|	Запись.ДатаОкончания КАК ДатаОкончания,
	|	Запись.Статус КАК Статус
	|ИЗ
	|	Документ.ЗаписьНаПриём КАК Запись
	|ГДЕ
	|	Запись.ПометкаУдаления = ЛОЖЬ
	|	И Запись.ДатаНачала < &Конец
	|	И Запись.ДатаОкончания > &Начало";
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Запрос.УстановитьПараметр("Конец", КонецПериода);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Планировщик.Элементы.Добавить(Выборка.ДатаНачала, Выборка.ДатаОкончания);
		// Значения измерений задаются целиком: ключ - измерение, значение - сотрудник.
		ЗначенияИзмерений = Новый Соответствие;
		ЗначенияИзмерений.Вставить("Сотрудник", Выборка.Исполнитель);
		Элемент.ЗначенияИзмерений = Новый ФиксированноеСоответствие(ЗначенияИзмерений);
		Элемент.Текст = Строка(Выборка.Покупатель);
		Элемент.Значение = Выборка.Ссылка;
		Если Выборка.Статус = Перечисления.СтатусыЗаписи.УслугаОказана Тогда
			Элемент.ЦветФона = Новый Цвет(190, 190, 190);
		Иначе
			Элемент.ЦветФона = Новый Цвет(144, 238, 144);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Заполняет планировщик при открытии формы.
// Параметры: Отказ, СтандартнаяОбработка - стандартные параметры события.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьПланировщикНаСервере();
КонецПроцедуры

// Обновляет планировщик по текущему значению НачалоПериода.
// Параметры: нет.
&НаКлиенте
Процедура ОбновитьПланировщик()
	НачалоПериода = НачалоДня(НачалоПериода);
	ЗаполнитьПланировщикНаСервере();
КонецПроцедуры

// Перестраивает планировщик, когда пользователь выбрал другую дату.
// Параметры: Элемент - поле формы.
&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	ОбновитьПланировщик();
КонецПроцедуры

// Сдвигает период на 7 дней назад.
// Параметры: Команда - команда формы.
&НаКлиенте
Процедура НеделяНазад(Команда)
	НачалоПериода = НачалоПериода - 7 * 86400;
	ОбновитьПланировщик();
КонецПроцедуры

// Сдвигает период на 7 дней вперёд.
// Параметры: Команда - команда формы.
&НаКлиенте
Процедура НеделяВперед(Команда)
	НачалоПериода = НачалоПериода + 7 * 86400;
	ОбновитьПланировщик();
КонецПроцедуры

// Возвращает период к сегодняшнему дню.
// Параметры: Команда - команда формы.
&НаКлиенте
Процедура Сегодня(Команда)
	НачалоПериода = НачалоДня(ТекущаяДата());
	ОбновитьПланировщик();
КонецПроцедуры

// Открывает существующую запись на приём по двойному щелчку.
// Параметры: Элемент - поле планировщика; НовыйЭлемент - признак создания нового;
//            СтандартнаяОбработка - Ложь отключает встроенное редактирование.
&НаКлиенте
Процедура ПланировщикПередНачаломРедактирования(Элемент, НовыйЭлемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если НовыйЭлемент Тогда
		Возврат; // Новые записи создаёт ПланировщикПередСозданием.
	КонецЕсли;
	ЗаписьСсылка = ПолучитьВыбраннуюЗапись();
	Если ЗаписьСсылка = Неопределено Тогда
		Сообщить("Не удалось определить выбранную запись.");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Документ.ЗаписьНаПриём.ФормаОбъекта",
		Новый Структура("Ключ", ЗаписьСсылка), , , , ,
		Новый ОписаниеОповещения("ОбновитьПослеЗакрытия", ЭтотОбъект));
КонецПроцедуры

// Создаёт запись на приём по двойному щелчку на свободной ячейке.
// Параметры: Начало, Конец - границы выбранной ячейки; ЗначенияИзмерений - соответствие
//            «измерение - значение» (здесь «Сотрудник»); СтандартнаяОбработка - Ложь.
&НаКлиенте
Процедура ПланировщикПередСозданием(Элемент, Начало, Конец, ЗначенияИзмерений, Текст, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Исполнитель = ЗначенияИзмерений.Получить("Сотрудник");
	Если Исполнитель = Неопределено Тогда
		Сообщить("Выберите ячейку в столбце сотрудника.");
		Возврат;
	КонецЕсли;
	Заполнение = Новый Структура;
	Заполнение.Вставить("Исполнитель", Исполнитель);
	Заполнение.Вставить("Организация", ПолучитьОрганизациюСотрудника(Исполнитель));
	Заполнение.Вставить("ДатаНачала", Начало);
	Заполнение.Вставить("ДатаОкончания", Конец);
	ОткрытьФорму("Документ.ЗаписьНаПриём.ФормаОбъекта",
		Новый Структура("ЗначенияЗаполнения", Заполнение), , , , ,
		Новый ОписаниеОповещения("ОбновитьПослеЗакрытия", ЭтотОбъект));
КонецПроцедуры

// Возвращает ссылку на запись, выбранную в планировщике.
// Параметры: нет. Возврат: ссылка на документ или Неопределено.
&НаКлиенте
Функция ПолучитьВыбраннуюЗапись()
	Выделенные = Элементы.Планировщик.ВыделенныеЭлементы;
	Если Выделенные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Выделенные[0].Значение;
КонецФункции

// Возвращает организацию сотрудника для подстановки в новую запись.
// Параметры: Сотрудник - СправочникСсылка.СотрудникиОрганизации.
&НаСервереБезКонтекста
Функция ПолучитьОрганизациюСотрудника(Сотрудник)
	Возврат Сотрудник.Организация;
КонецФункции

// Обновляет планировщик после закрытия формы записи.
// Параметры: Результат, ДополнительныеПараметры - стандартные параметры оповещения.
&НаКлиенте
Процедура ОбновитьПослеЗакрытия(Результат, ДополнительныеПараметры) Экспорт
	ОбновитьПланировщик();
КонецПроцедуры